# OpenETL data lab. Copy to .env and fill in. .env is not committed.
# Folder of the OpenETL repo checkout used by scripts/load.sh (default: ../openetl next to this folder).
OPENETL_REPO=../openetl
# Set to 1 to also download the 186 MB HDFS log archive in scripts/download.sh.
HDFS=0
# Database logins (local lab only; must match docker-compose.yml).
# Postgres:   postgresql://lab:lab@127.0.0.1:5433/openetl
# ClickHouse: user lab, password lab, http://127.0.0.1:8123
